# Docker ignore file to exclude unnecessary files from build context

# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Logs and checkpoints
*.log
checkpoints/
logs/
*.monitor.csv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test outputs
test/*.log
test/__pycache__/

# Documentation (not needed in container)
*.md
!README.md

# Temporary files
*.tmp
*.bak
*.cache

